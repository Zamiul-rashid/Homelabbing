---
import PageLayout from '../layouts/PageLayout.astro';

const repo = 'https://github.com/Zamiul-rashid/Homelabbing/blob/main/docs';

const guides = [
  {
    file: '01-what-is-selfhosting.md',
    title: 'What is self-hosting?',
    body: 'Why people host their own data, what it really costs compared with subscriptions, and what you take on in return.',
  },
  {
    file: '02-understanding-docker.md',
    title: 'Understanding Docker and containers',
    body: 'Images, containers, bind mounts such as /config, port mappings, and what a Compose file actually describes.',
  },
  {
    file: '03-your-first-server.md',
    title: 'Your first server: hardware and OS',
    body: 'From a used office mini PC to a custom build. Install Ubuntu Server or Debian, set a static address and connect over SSH.',
  },
  {
    file: '04-storage-and-nas.md',
    title: 'Storage, disks and NAS concepts',
    body: 'Pooling drives with mergerfs, parity with SnapRAID, ZFS basics, ownership and permissions, and why one /data tree allows hardlinks.',
  },
  {
    file: '05-networking-concepts.md',
    title: 'Networking and remote access',
    body: 'Local and public addresses, port forwarding, DNS records, reverse proxies, TLS certificates and Tailscale.',
  },
  {
    file: '06-backups-and-redundancy.md',
    title: 'Backups and disaster recovery',
    body: 'RAID is not a backup. The 3-2-1 rule, backing up small config folders separately from bulk media, and restoring after a drive failure.',
  },
  {
    file: '07-security-basics.md',
    title: 'Security basics',
    body: 'SSH keys instead of passwords, a firewall, fail2ban, and never exposing database ports to the internet.',
  },
  {
    file: '08-home-automation-and-ad-blocking.md',
    title: 'Home automation and ad blocking',
    body: 'Local control of smart devices with Home Assistant, and network-wide ad and tracker blocking with AdGuard Home.',
  },
];
---

<PageLayout
  title="Concepts"
  description="Eight short guides that explain the ideas behind every stack. Read them in order or jump to the one you need. They open on GitHub."
  prose={false}
>
  <ol class="grid max-w-5xl gap-x-12 md:grid-cols-2">
    {guides.map((g, i) => (
      <li class="border-t border-border">
        <a href={`${repo}/${g.file}`} target="_blank" rel="noopener noreferrer" class="group flex gap-4 py-6">
          <span class="w-6 shrink-0 pt-0.5 font-mono text-sm text-text-faint">{i + 1}</span>
          <span>
            <span class="flex items-center gap-2 text-lg font-semibold tracking-[-0.01em] text-text group-hover:text-accent">
              {g.title}
              <svg class="h-4 w-4 shrink-0 text-text-faint group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              <span class="sr-only">(opens on GitHub)</span>
            </span>
            <span class="mt-1.5 block text-[15px] leading-relaxed text-text-muted">{g.body}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <p class="mt-10 max-w-measure text-[15px] leading-relaxed text-text-muted">
    The guides live in the repository's <code class="inline-code">docs/</code> folder, next to the stacks they explain.
    Ready to build? Go to the <a href="/Homelabbing/getting-started" class="text-link">guide</a>.
  </p>
</PageLayout>
