---
import PageLayout from '../../layouts/PageLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, categories } from '../../data/services';

const groups = categories
  .map((c) => ({ ...c, items: services.filter((s) => s.category === c.id) }))
  .filter((g) => g.items.length > 0);
const withStack = services.filter((s) => s.folder).length;
---

<PageLayout
  title="Services"
  description="Every app in the guide, grouped by what it does. Pick one to see what it is for and how to set it up."
  prose={false}
>
  <section aria-labelledby="stacks-title">
    <h2 id="stacks-title" class="sr-only">Services by category</h2>

    <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="Filter by purpose" data-filter>
      <button type="button" class="filter-btn" aria-pressed="true" data-filter-value="all">
        All <span class="text-text-faint">{services.length}</span>
      </button>
      {groups.map((g) => (
        <button type="button" class="filter-btn" aria-pressed="false" data-filter-value={g.id}>
          {g.label} <span class="text-text-faint">{g.items.length}</span>
        </button>
      ))}
    </div>
    <p class="mb-12 max-w-measure text-sm leading-relaxed text-text-muted">
      {withStack} of these have a beginner stack in this repository. The rest link to the project's official install
      guide.
    </p>

    <div class="space-y-14" data-filter-list>
      {groups.map((g) => (
        <section aria-labelledby={`cat-${g.id}`} data-category={g.id}>
          <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-border pb-3">
            <h2 id={`cat-${g.id}`} class="text-xl font-semibold tracking-[-0.01em] text-text">
              {g.label} <span class="text-base font-normal text-text-faint">{g.items.length}</span>
            </h2>
            <p class="text-sm text-text-muted">{g.blurb}</p>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((s) => (
              <li>
                <ServiceCard service={s} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="mt-20 grid gap-10 border-t border-border pt-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <div>
      <h2 class="section-title">Why one stack per app?</h2>
      <p class="mt-4 text-[17px] leading-relaxed text-text-muted">
        Many homelab repositories put 30 or more containers in one Compose file. When one database fails or two apps
        clash, everything stops. Here each beginner stack has its own folder in <code class="inline-code">stacks/</code>,
        and the same idea works for apps you install from their official guides.
      </p>
    </div>
    <dl class="space-y-6 text-[17px] leading-relaxed">
      <div>
        <dt class="font-semibold text-text">Update one app at a time</dt>
        <dd class="mt-1 text-text-muted">Upgrade Navidrome or Kavita without taking Jellyfin offline.</dd>
      </div>
      <div>
        <dt class="font-semibold text-text">Put each app where it fits</dt>
        <dd class="mt-1 text-text-muted">Run light services on a Raspberry Pi or mini PC, and heavy ones such as Immich on a stronger machine.</dd>
      </div>
      <div>
        <dt class="font-semibold text-text">Learn one thing at a time</dt>
        <dd class="mt-1 text-text-muted">Get one service working before you add the next, then combine them in <code class="inline-code">full-stack</code> if you want.</dd>
      </div>
    </dl>
  </section>
</PageLayout>

<style>
  .filter-btn {
    @apply inline-flex items-center gap-2 rounded-md border border-border-strong bg-bg-surface px-3.5 py-2 text-sm font-medium text-text-muted transition-colors hover:border-text-muted hover:text-text;
  }
  .filter-btn[aria-pressed='true'] {
    @apply border-accent bg-accent text-accent-ink;
  }
  .filter-btn[aria-pressed='true'] span {
    @apply text-accent-ink;
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter]');
  const list = document.querySelector<HTMLElement>('[data-filter-list]');
  if (group && list) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button[data-filter-value]'));
    const sections = Array.from(list.querySelectorAll<HTMLElement>(':scope > section[data-category]'));
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter-value]');
      if (!btn) return;
      const value = btn.dataset.filterValue;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      sections.forEach((section) => {
        section.hidden = value !== 'all' && section.dataset.category !== value;
      });
    });
  }
</script>
