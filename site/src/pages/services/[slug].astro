---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import WhatNowCards from '../../components/WhatNowCards.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { services as serviceCatalog, difficultyLabel } from '../../data/services';

export async function getStaticPaths() {
  const serviceEntries = await getCollection('services');
  return serviceEntries.map((entry) => {
    const catalogItem = serviceCatalog.find((s) => s.slug === entry.slug);
    return {
      params: { slug: entry.slug },
      props: { entry, catalogItem },
    };
  });
}

const { entry, catalogItem } = Astro.props;
const { Content } = await entry.render();

const name = catalogItem?.name ?? entry.data.title;
const folder = entry.data.folder;
const repoFolder = folder ? `https://github.com/Zamiul-rashid/Homelabbing/tree/main/stacks/${folder}` : undefined;
const installDocs = entry.data.installDocs;
const index = serviceCatalog.findIndex((s) => s.slug === entry.slug);
const next = index >= 0 ? serviceCatalog[(index + 1) % serviceCatalog.length] : undefined;
---

<PageLayout
  title={entry.data.title}
  heading={entry.data.title}
  description={entry.data.tagline}
  parents={[{ label: 'Services', href: '/Homelabbing/services' }]}
>
  <div class="not-prose mb-10 rounded-md border border-border bg-bg-surface">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-t-md bg-border sm:grid-cols-3">
      <div class="bg-bg-surface p-4">
        <dt class="text-sm text-text-faint">Service</dt>
        <dd class="mt-1 font-medium text-text">{name}</dd>
      </div>
      <div class="bg-bg-surface p-4">
        <dt class="text-sm text-text-faint">Difficulty</dt>
        <dd class="mt-1 font-medium text-text">{difficultyLabel(entry.data.difficulty)}</dd>
      </div>
      <div class="col-span-2 bg-bg-surface p-4 sm:col-span-1">
        <dt class="text-sm text-text-faint">Beginner stack</dt>
        {folder ? (
          <dd class="mt-1 break-all font-mono text-sm text-text">stacks/{folder}</dd>
        ) : (
          <dd class="mt-1 font-medium text-text">Not yet</dd>
        )}
      </div>
    </dl>
    <div class="border-t border-border p-5">
      <h2 class="text-base font-semibold text-text">Quick start</h2>
      {!folder && (
        <p class="mt-3 text-[15px] leading-relaxed text-text-muted">
          There is no beginner stack for {name} in this repository yet. Follow the project's official install guide
          (linked below); these steps are the outline.
        </p>
      )}
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-text-muted marker:text-text-faint">
        {entry.data.setupSteps.map((step) => (
          <li>{step.split('`').map((part, i) => (i % 2 ? <code class="inline-code">{part}</code> : part))}</li>
        ))}
      </ol>
      {folder && <CodeBlock title="Start this stack" code={`cd stacks/${folder} && docker compose up -d`} />}
      <div class={`flex flex-wrap gap-x-6 gap-y-2 text-sm ${folder ? '' : 'mt-4'}`}>
        {repoFolder && (
          <a href={repoFolder} target="_blank" rel="noopener noreferrer" class="text-link">View the Compose file on GitHub</a>
        )}
        {installDocs && (
          <a href={installDocs} target="_blank" rel="noopener noreferrer" class="text-link">Official install guide</a>
        )}
      </div>
    </div>
  </div>

  <Content />

  {entry.data.whatNow && entry.data.whatNow.length > 0 && <WhatNowCards items={entry.data.whatNow} />}

  <nav aria-label="More services" class="not-prose mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-sm">
    <a href="/Homelabbing/services" class="text-text-muted hover:text-text">All services</a>
    {next && (
      <a href={`/Homelabbing/services/${next.slug}`} class="text-link">Next: {next.name}</a>
    )}
  </nav>
</PageLayout>
