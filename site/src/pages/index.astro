---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, categories, difficultyLabel } from '../data/services';

const base = '/Homelabbing';

const hardware = [
  {
    name: 'An old computer',
    cost: 'Free',
    power: 'High',
    body: 'You may have an old laptop or PC waiting to be repurposed. It is the perfect first server because it costs nothing, and a laptop battery even works as a small UPS.',
    goodFor: 'Docker, a hypervisor such as Proxmox, a NAS such as Unraid',
  },
  {
    name: 'Raspberry Pi',
    cost: '$15 to $35+',
    power: 'Very low',
    body: 'A small but capable machine with a large community. Great for always-on light jobs.',
    goodFor: 'Pi-hole, Home Assistant',
    note: 'Do not rely on a Pi to hold the only copy of your data.',
  },
  {
    name: 'NAS appliance',
    cost: '$250 to $500+',
    power: 'Medium',
    body: 'Synology, Ugreen and others sell ready-made NAS boxes. You can also build the same thing from a second-hand PC and a few hard drives, with full control and no brand premium.',
    goodFor: 'Network storage, a media server',
  },
  {
    name: 'Second-hand PC',
    cost: '$50 to $300+',
    power: 'Medium to high',
    body: 'Like the old computer, with much more choice. Ex-office machines such as a Dell OptiPlex or Lenovo ThinkCentre are ideal and give you the most room to grow.',
    goodFor: 'Proxmox, any Linux distribution',
  },
];
---

<BaseLayout
  title="Home"
  description="A beginner guide to self-hosting your media, photos and files at home with Docker Compose."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-text sm:text-6xl lg:text-7xl">
        Own your cloud.
        <span class="block text-accent">Drop the subscriptions.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-muted">
        Run your own media, photos and files at home. No monthly fees, and your data stays yours.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}/getting-started`} class="btn-primary">Start the guide</a>
        <a href={`${base}/services`} class="btn-secondary">Browse services</a>
      </div>
    </div>

    <figure class="mt-14">
      <a
        href={`${import.meta.env.BASE_URL}/beginner-architecture.png`}
        class="block overflow-hidden rounded-md border border-border bg-bg-surface transition-colors hover:border-border-strong"
      >
        <img
          src={`${import.meta.env.BASE_URL}/beginner-architecture.png`}
          width="2528"
          height="2471"
          alt="Architecture of the stacks in this guide. Four remote access options (DuckDNS, Cloudflare Tunnel, your own domain, Tailscale) lead through the home router to Nginx Proxy Manager, which routes to Jellyfin, the *arr stack, Navidrome, Immich, Kavita, Nextcloud and Home Assistant with AdGuard Home. Under them sit Docker Compose and the health-check script, then /config on the SSD, /data on the hard drives, and a backup disk."
          class="h-auto w-full"
          fetchpriority="high"
        />
      </a>
      <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-sm text-text-muted">
        <span>How the stacks in this guide fit together, from the four ways in down to the disks.</span>
        <a href={`${import.meta.env.BASE_URL}/beginner-architecture.png`} class="text-link">Open full size</a>
      </figcaption>
    </figure>
  </section>

  <!-- Starting a homelab -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div>
          <h2 class="section-title">Starting a homelab</h2>
          <div class="mt-5 space-y-4 text-[17px] leading-relaxed text-text-muted">
            <p>
              Homelabbing can feel overwhelming at first. Browse
              <a href="https://www.reddit.com/r/homelab/" class="text-link" target="_blank" rel="noopener noreferrer">r/homelab</a>
              and you will find racks full of servers and network gear. The good news: a homelab can be as big, or as small,
              as you want.
            </p>
          </div>
          <h3 class="mt-10 text-lg font-semibold text-text">Why start one?</h3>
          <ul class="mt-4 space-y-4 text-[17px] leading-relaxed text-text-muted">
            <li>
              <span class="font-medium text-text">To learn.</span> Practise a technology for work or study, for example a
              second-hand Cisco switch for a networking certification.
            </li>
            <li>
              <span class="font-medium text-text">To self-host.</span> Rely less on big tech: replace Dropbox with
              Nextcloud, or block ads for the whole house with Pi-hole.
            </li>
          </ul>
          <div class="callout-warn mt-10">
            <p class="font-semibold text-text">Keep it off the internet at first</p>
            <p class="mt-1 text-text-muted">
              It is tempting to open your new server to the internet. Unless you understand the risks and how to reduce
              them (firewalls, VPNs, tunnels), do not. The
              <a href={`${base}/networking`} class="text-link">networking guide</a> shows safe ways in.
            </p>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-text">Hardware options</h3>
          <p class="mt-2 text-text-muted">Four common ways to start, cheapest first.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {hardware.map((h) => (
              <article class="panel flex flex-col p-5">
                <h4 class="text-base font-semibold text-text">{h.name}</h4>
                <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                  <dt class="text-text-faint">Cost</dt>
                  <dd class="text-text">{h.cost}</dd>
                  <dt class="text-text-faint">Power draw</dt>
                  <dd class="text-text">{h.power}</dd>
                </dl>
                <p class="mt-4 text-[15px] leading-relaxed text-text-muted">{h.body}</p>
                {h.note && <p class="mt-3 text-[15px] leading-relaxed text-warning">{h.note}</p>}
                <p class="mt-auto pt-4 text-sm text-text-muted">
                  <span class="text-text-faint">Good for: </span>{h.goodFor}
                </p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pick a stack -->
  <section class="border-t border-border bg-bg-surface/60">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="section-title">Pick where you want to start</h2>
          <p class="mt-3 text-[17px] leading-relaxed text-text-muted">
            Each stack lives in its own folder and runs on its own. Start with one, learn it, then add the next.
          </p>
        </div>
        <a href={`${base}/services`} class="text-link text-sm">All {services.length} services</a>
      </div>

      <div class="mt-10 grid gap-x-10 gap-y-12 md:grid-cols-3">
        {categories.filter((cat) => services.some((s) => s.category === cat.id && s.folder)).map((cat) => (
          <div>
            <h3 class="border-b border-border pb-3 text-sm font-semibold text-text-muted">{cat.label}</h3>
            <ul class="divide-y divide-border">
              {services.filter((s) => s.category === cat.id && s.folder).map((s) => (
                <li>
                  <a href={`${base}/services/${s.slug}`} class="group block py-4">
                    <span class="flex items-baseline justify-between gap-3">
                      <span class="font-medium text-text group-hover:text-accent">{s.name}</span>
                      <span class="shrink-0 text-xs text-text-faint">{difficultyLabel(s.difficulty)}</span>
                    </span>
                    <span class="mt-1 block text-sm leading-relaxed text-text-muted">{s.tagline}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-6 border-t border-border pt-8 text-[15px] leading-relaxed text-text-muted md:grid-cols-2">
        <p>
          Want everything at once? <code class="inline-code">stacks/full-stack</code> combines all of them in one
          Compose file. Try it after you have run a few stacks on their own.
        </p>
        <p>
          New to Docker, networks or volumes? The <a href={`${base}/concepts`} class="text-link">concept guides</a> explain
          them in plain language. Once a stack is up, <code class="inline-code">./helpers/check-health.sh</code> checks
          every service in one go.
        </p>
      </div>
    </div>
  </section>

  <!-- The author's lab -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="grid gap-10 rounded-md border border-border p-6 sm:p-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div>
          <h2 class="section-title">How I run it at home</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-text-muted">
            This guide is the beginner version of my own lab. It has grown to two small servers, monitoring that
            messages my phone, and backups that run on their own. I wrote up how it fits together and what I learned.
          </p>
          <a href={`${base}/my-lab`} class="btn-secondary mt-8">See my lab</a>
        </div>
        <ul class="space-y-4 self-center text-[15px] leading-relaxed text-text-muted">
          <li class="border-l border-border-strong pl-4">
            <span class="font-medium text-text">Two servers, split by job:</span> one runs the apps, a Proxmox host
            runs monitoring and holds the media and backup disks.
          </li>
          <li class="border-l border-border-strong pl-4">
            <span class="font-medium text-text">Quiet disks:</span> heavy disk jobs run together at night, so the hard
            drives can sleep the rest of the day.
          </li>
          <li class="border-l border-border-strong pl-4">
            <span class="font-medium text-text">One way in:</span> a single reverse proxy faces the internet, and admin
            tools only answer on the LAN or over a VPN.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-[-0.025em] text-text sm:text-4xl">
        Start small. Add a stack when you need one.
      </h2>
      <p class="mt-4 max-w-measure text-[17px] leading-relaxed text-text-muted">
        Every step in the guide explains what a command does before you run it. For more apps to try later, the
        <a href="https://www.awesome-homelab.com/" target="_blank" rel="noopener noreferrer" class="text-link">Awesome-Homelab</a>
        directory lists hundreds of them.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}/getting-started`} class="btn-primary">Start the guide</a>
        <a href="https://github.com/Zamiul-rashid/Homelabbing" target="_blank" rel="noopener noreferrer" class="btn-secondary">Star on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
