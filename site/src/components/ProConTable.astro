---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="not-prose my-8 grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
  <div class="bg-bg-surface p-5">
    <h3 class="mb-3 text-sm font-semibold text-text">Advantages</h3>
    <ul class="space-y-2.5 text-[15px] leading-relaxed text-text-muted">
      {pros.map((pro) => (
        <li class="flex gap-3">
          <svg class="mt-1 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
          <span>{pro}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="bg-bg-surface p-5">
    <h3 class="mb-3 text-sm font-semibold text-text">Considerations</h3>
    <ul class="space-y-2.5 text-[15px] leading-relaxed text-text-muted">
      {cons.map((con) => (
        <li class="flex gap-3">
          <svg class="mt-1 h-4 w-4 shrink-0 text-text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
          <span>{con}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
