---
interface Card {
  label: string;
  href: string;
  description: string;
}

interface Props {
  items: Card[];
}

const { items } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<section class="not-prose mt-14">
  <h2 class="mb-4 text-xl font-semibold tracking-[-0.01em] text-text">Next steps</h2>
  <ul class="divide-y divide-border rounded-md border border-border bg-bg-surface">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class="group flex items-start justify-between gap-6 p-4 sm:p-5"
        >
          <span>
            <span class="block font-medium text-text group-hover:text-accent">{item.label}</span>
            <span class="mt-1 block text-sm leading-relaxed text-text-muted">{item.description}</span>
          </span>
          <svg class="mt-1 h-4 w-4 shrink-0 text-text-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>
</section>
