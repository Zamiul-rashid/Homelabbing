---
const base = '/Homelabbing';
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { label: 'Guide', href: `${base}/getting-started`, match: ['/getting-started'] },
  { label: 'Services', href: `${base}/services`, match: ['/services'] },
  { label: 'Concepts', href: `${base}/concepts`, match: ['/concepts'] },
  { label: 'Networking', href: `${base}/networking`, match: ['/networking'] },
  { label: 'My lab', href: `${base}/my-lab`, match: ['/my-lab'] },
];

const isActive = (match: string[]) => match.some((m) => path.startsWith(`${base}${m}`));
const repo = 'https://github.com/Zamiul-rashid/Homelabbing';
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href={`${base}/`} class="flex items-center gap-2.5 rounded-md text-text">
      <svg class="h-8 w-8 shrink-0" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#F65A26" />
        <path d="M9 15.5 16 9l7 6.5M11 14v8.5h4v-5h2v5h4V14" stroke="#0A0B0F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="text-base font-semibold tracking-[-0.01em]">Homelabbing</span>
    </a>

    <ul class="hidden items-center gap-1 text-sm lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.match) ? 'page' : undefined}
            class:list={[
              'relative block px-3 py-2 transition-colors',
              isActive(l.match)
                ? 'text-text after:absolute after:inset-x-3 after:-bottom-[13px] after:h-0.5 after:bg-accent'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="ml-3">
        <a href={repo} target="_blank" rel="noopener noreferrer" class="btn-secondary px-3.5 py-2 text-sm font-medium">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
      </li>
    </ul>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border-strong text-text-muted hover:text-text lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="border-t border-border bg-bg-surface lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.match) ? 'page' : undefined}
            class:list={[
              'block rounded-md px-3 py-3 text-base',
              isActive(l.match) ? 'bg-bg-elevated text-text' : 'text-text-muted hover:text-text',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a href={repo} target="_blank" rel="noopener noreferrer" class="block rounded-md px-3 py-3 text-base text-text-muted hover:text-text">
          GitHub repository
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
