---
import { difficultyLabel, type Service } from '../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a
  href={`/Homelabbing/services/${service.slug}`}
  class="group flex h-full flex-col gap-3 rounded-md border border-border bg-bg-surface p-5 text-text no-underline transition-colors hover:border-accent/70"
  data-category={service.category}
>
  <div class="flex items-start justify-between gap-3">
    <Heading class="text-lg font-semibold tracking-[-0.01em] text-text group-hover:text-accent">{service.name}</Heading>
    <span class="chip shrink-0">{difficultyLabel(service.difficulty)}</span>
  </div>
  <p class="flex-grow text-sm leading-relaxed text-text-muted">{service.tagline}</p>
  <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 border-t border-border pt-3 text-sm">
    <dt class="text-text-faint">Replaces</dt>
    <dd class="text-text-muted">{service.replaces}</dd>
    <dt class="text-text-faint">Setup</dt>
    <dd class="text-text-muted">{service.folder ? 'Beginner stack in this repo' : 'Official install guide'}</dd>
  </dl>
</a>
