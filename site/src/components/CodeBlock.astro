---
import CopyButton from './CopyButton';

interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'bash', title } = Astro.props;
---

<figure class="not-prose my-6 overflow-hidden rounded-md border border-border bg-bg-surface">
  <figcaption class="flex items-center justify-between gap-3 border-b border-border bg-bg-elevated px-4 py-2">
    <span class="truncate text-sm text-text-muted">{title ?? (language === 'bash' ? 'Terminal' : language)}</span>
    <span class="flex shrink-0 items-center gap-3">
      <span class="font-mono text-xs text-text-faint">{language}</span>
      <CopyButton client:visible code={code} />
    </span>
  </figcaption>
  <pre class="m-0 overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-text sm:text-sm"><code class={`language-${language}`}>{code}</code></pre>
</figure>
