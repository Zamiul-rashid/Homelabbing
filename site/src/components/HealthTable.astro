---
import { services } from '../data/services';
---

<div class="not-prose my-8 overflow-hidden rounded-md border border-border">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[34rem] text-left text-sm">
      <caption class="sr-only">Default port, local address and folder for each stack</caption>
      <thead class="border-b border-border bg-bg-elevated text-text-muted">
        <tr>
          <th scope="col" class="px-4 py-3 font-medium">Service</th>
          <th scope="col" class="px-4 py-3 font-medium">Port</th>
          <th scope="col" class="px-4 py-3 font-medium">Local address</th>
          <th scope="col" class="px-4 py-3 font-medium">Folder</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-bg-surface">
        {services.map((s) => (
          <tr>
            <th scope="row" class="px-4 py-3 font-medium text-text">
              <a href={`/Homelabbing/services/${s.slug}`} class="hover:text-accent">{s.name}</a>
            </th>
            <td class="px-4 py-3 font-mono text-accent">{s.port}</td>
            <td class="px-4 py-3 font-mono text-text-muted">http://YOUR_SERVER_IP:{s.port}</td>
            <td class="px-4 py-3 font-mono text-text-muted">stacks/{s.folder}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
