---
const currentYear = new Date().getFullYear();
const base = '/Homelabbing';
---

<footer class="mt-24 border-t border-border bg-bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-[1fr_auto]">
    <div class="max-w-sm">
      <p class="font-semibold text-text">Homelabbing</p>
      <p class="mt-2 text-sm leading-relaxed text-text-muted">
        A beginner guide to self-hosting with Docker Compose. Open source under the MIT licence.
      </p>
      <p class="mt-4 text-sm text-text-faint">&copy; {currentYear} Zamiul Rashid</p>
    </div>

    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm sm:grid-cols-3">
        <li><a href={`${base}/getting-started`} class="text-text-muted hover:text-text">Guide</a></li>
        <li><a href={`${base}/services`} class="text-text-muted hover:text-text">Services</a></li>
        <li><a href={`${base}/concepts`} class="text-text-muted hover:text-text">Concepts</a></li>
        <li><a href={`${base}/networking`} class="text-text-muted hover:text-text">Networking</a></li>
        <li><a href={`${base}/my-lab`} class="text-text-muted hover:text-text">My lab</a></li>
        <li><a href="https://github.com/Zamiul-rashid/Homelabbing" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text">GitHub</a></li>
        <li><a href="https://trash-guides.info" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text">TRaSH Guides</a></li>
      </ul>
    </nav>
  </div>
</footer>
